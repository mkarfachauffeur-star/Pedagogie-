# PEDAGOGIA DRIVE — variables d'environnement
# Copier ce fichier en `.env` (non versionné) et renseigner les valeurs.

# URL publique de l'application (invitations, redirections auth)
# En local : http://192.168.x.x:5173 ou http://localhost:5173
VITE_APP_URL=http://localhost:5173

# URL du projet Supabase (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anon (Dashboard > Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
