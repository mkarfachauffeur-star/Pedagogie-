{
  "name": "pedagogia-drive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:login": "npx supabase login",
    "supabase:link": "npx supabase link --project-ref watdeahravfccjdoseaf",
    "supabase:deploy:signup": "npx supabase functions deploy register-organization --no-verify-jwt",
    "supabase:deploy:functions": "npm run supabase:deploy:signup && npx supabase functions deploy invite-user && npx supabase functions deploy create-student && npx supabase functions deploy manage-user",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "seed:demo:reset": "node scripts/seed-demo-data.mjs --reset",
    "verify:demo-rls": "node scripts/verify-demo-rls.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:post-migrations": "node scripts/verify-post-migrations.mjs",
    "verify:exports-schema": "node scripts/verify-exports-schema.mjs",
    "verify:remc-p2": "node scripts/verify-remc-p2.mjs",
    "validate:production": "node scripts/validate-production-functional.mjs",
    "build:production": "npm run build && npm run audit:production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.3.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.39.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
